    {
        "id": "b64a59d4b371566e",
        "type": "function",
        "z": "ebf5a8a51a479aee",
        "name": "fanout metrics",
        "func": "const m = msg.payload || {};\n\nconst rssi = (typeof m.rssi_dbm === \"number\") ? m.rssi_dbm : null;\nconst snr = (typeof m.snr_db === \"number\") ? m.snr_db : null;\nconst last = (m.last_rx_time && String(m.last_rx_time).length > 0) ? m.last_rx_time : \"-\";\nconst ppm = (typeof m.pkts_last_min === \"number\") ? m.pkts_last_min : 0;\n\nconst out1 = { payload: (rssi !== null) ? `${rssi} dBm` : \"-\" };\nconst out2 = { payload: (snr !== null) ? `${snr} dB` : \"-\" };\nconst out3 = { payload: `${last}` };\nconst out4 = { payload: `${ppm}` };\n\n// Gauge wants a NUMBER payload\nconst out5 = { payload: (rssi !== null) ? rssi : -120 };\n\nreturn [[out1], [out2], [out3], [out4], [out5]];\n",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
