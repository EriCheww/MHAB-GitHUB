        "func": "// // msg.payload is an array\n// let rows = msg.payload || [];\n\n// // sort: TIMEOUT first, then RETRYING, then WAITING_ACK\n// const prio = { \"TIMEOUT\": 0, \"RETRYING\": 1, \"WAITING_ACK\": 2 };\n// rows.sort((a,b) => (prio[a.state] ?? 9) - (prio[b.state] ?? 9) || b.cmd_seq - a.cmd_seq);\n// rows = rows.slice(0, 20);   \n\n\n// msg.payload = rows;\n// return msg;\n// // add a display field (optional)\n// rows = rows.map(r => ({\n//     ...r,\n//     state_display: r.state\n// }));\n\n// msg.payload = rows;\n// return msg;\nconst N = 20; // keep latest 20\n\nlet rows = Array.isArray(msg.payload) ? msg.payload : [];\n\n// newest first\nrows.sort((a,b) => (b.cmd_seq ?? 0) - (a.cmd_seq ?? 0));\n\n// keep only latest N\nrows = rows.slice(0, N);\n\nmsg.payload = rows;\nreturn msg;",
