    {
        "id": "7d7236b37a42831c",
        "type": "function",
        "z": "ebf5a8a51a479aee",
        "name": "append history",
        "func": "const res = msg.payload || {};\nconst cmd = msg._cmd || res.received_cmd || \"unknown\";\n\nconst row = {\n    Time: new Date().toLocaleString(),\n    Command: cmd,\n    CmdSeq: res.cmd_seq ?? \"\",\n    Status: res.status ?? \"\",\n    Result: (res.ok ? \"OK\" : \"ERROR\")\n};\n\nlet hist = flow.get(\"cmd_history\") || [];\nhist.unshift(row);          // newest first\nhist = hist.slice(0, 20);   // keep last 20\nflow.set(\"cmd_history\", hist);\n\nmsg.payload = hist;         // table expects array of row objects\nreturn msg;\n// const N = 50; // keep latest 50\n\n// let hist = flow.get(\"cmd_history\") || [];\n\n// // if you're currently pushing to the end, you can keep it,\n// // but usually newest-at-top is nicer:\n// hist.unshift(msg.payload);   // put newest first\n// hist = hist.slice(0, N);\n\n// flow.set(\"cmd_history\", hist);\n\n// msg.payload = hist;\n// return msg;\n",
