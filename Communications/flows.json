    {
        "id": "dec5b3e2c6b47ca1",
        "type": "function",
        "z": "ebf5a8a51a479aee",
        "name": "function 1",
        "func": "// Create a mock MHAB telemetry packet (JSON)\nconst now = new Date();\n\nmsg.payload = {\n    type: \"telemetry\",\n    seq: (msg.seq || 0) + 1,\n    ts: now.toISOString(),\n    payload_len: 84,\n\n    battery_v: 7.91,\n    temps_c: [\n        { id: \"pi\", name: \"Raspberry Pi\", value: 41.2 },\n        { id: \"payload\", name: \"Payload Bay\", value: 18.7 },\n        { id: \"gps\", name: \"GPS Module\", value: 22.3 }\n    ],\n\n\n    lat: -37.9100,\n    lon: 145.1300,\n    alt_m: 18250,\n\n    snr_db: 7.5,\n    rssi_dbm: -112,\n\n    fault_flags: 0\n};\n\n// keep a simple counter across clicks\nmsg.seq = msg.payload.seq;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
